platform :ios, '16.4'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. Run flutter pub get first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise 'FLUTTER_ROOT was not found in Generated.xcconfig'
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # MediaPipe/LiteRT mobile inference requires static CocoaPods frameworks.
  use_frameworks! :linkage => :static
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # flutter_gemma/MediaPipe GenAI requires iOS 16. Keep every transitive
      # CocoaPod aligned so CocoaPods cannot resolve part of the graph at 15.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.4'
      if target.name == 'permission_handler_apple'
        # Compile only the permission handlers used by provisioning and voice.
        # A missing macro leaves that permission permanently denied on iOS.
        definitions = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
        definitions = [definitions] if definitions.is_a?(String)
        definitions.reject! { |value| value.start_with?('PERMISSION_') }
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = definitions + %w[
          PERMISSION_MICROPHONE=1
          PERMISSION_SPEECH_RECOGNIZER=1
          PERMISSION_BLUETOOTH=1
          PERMISSION_LOCATION_WHENINUSE=1
          PERMISSION_LOCATION=0
          PERMISSION_CAMERA=0
          PERMISSION_PHOTOS=0
          PERMISSION_CONTACTS=0
          PERMISSION_NOTIFICATIONS=0
          PERMISSION_MEDIA_LIBRARY=0
        ]
      end
    end
  end
end
